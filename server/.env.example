# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Postgres (Supabase connection string — use the "Transaction" pooler URI for serverless,
# or the direct URI for local dev / migrations)
DATABASE_URL="postgresql://postgres:password@localhost:5432/digital_heroes"

# Supabase (Project Settings -> API)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"
SUPABASE_STORAGE_BUCKET="winner-proofs"

# Payment provider — "mock" needs no external account at all (simulates the
# gateway in-process; see server/src/lib/payments/mockProvider.ts). Switch to
# "razorpay" once you have real API keys (PRD §04 allows "Stripe or equivalent
# PCI-compliant provider" — Razorpay is used since Stripe is invite-only in India).
PAYMENT_PROVIDER=mock

# Only required when PAYMENT_PROVIDER=razorpay (Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"
RAZORPAY_PLAN_ID_MONTHLY="plan_..."
RAZORPAY_PLAN_ID_YEARLY="plan_..."

# Business rules (documented defaults; overridable without redeploying schema)
CHARITY_MIN_PERCENTAGE=10
PRIZE_POOL_PCT_OF_SUBSCRIPTION=20
